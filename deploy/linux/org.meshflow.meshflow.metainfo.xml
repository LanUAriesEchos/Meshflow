	<releases>
	<release version="1.0.0" date="2026-09-09" urgency="high">
		<description>
			<p>First stable release of Meshflow.</p>
			<ul>
				<li>Seamless keyboard and mouse sharing across Windows, macOS, and Linux</li>
				<li>TLS encrypted networking with automatic certificate management</li>
				<li>Clipboard sharing for text and images</li>
				<li>Synergy and Barrier protocol compatibility</li>
				<li>Qt-based GUI with visual screen arrangement</li>
			</ul>
		</description>
		<url>https://github.com/RimoraStudio/Aether/releases/tag/v1.0.0</url>
	</release>
